{
  "name": "zug-bingo",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Turn German train delays into a collectible bingo game (unofficial fan project).",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "report:balance": "tsx scripts/balance-report.ts"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "fake-indexeddb": "^6.2.6",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5",
    "yaml": "^2.9.1"
  },
  "dependencies": {
    "preact": "^10.29.8"
  }
}
